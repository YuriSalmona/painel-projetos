# Modelo dos secrets. Copie para .streamlit/secrets.toml (uso local) e/ou cole
# na aba "Secrets" do app no Streamlit Community Cloud.
# NUNCA commite o secrets.toml de verdade — ele já está no .gitignore.
#
# Os valores de client_id/client_secret são os mesmos dos outros apps do IC
# (OAuth Client do projeto GCP ee-yuri, que é INTERNO: sem limite de domínios).
# Só mudam o redirect_uri (aponta para a URL deste app) e o cookie_secret.
#
# Formato do PROVIDER PADRÃO: o app chama st.login() sem nome, então os campos
# ficam direto em [auth] (não use [auth.google]).

[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"
cookie_secret = "GERE_UMA_STRING_ALEATORIA_LONGA_AQUI"
client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "SEU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
